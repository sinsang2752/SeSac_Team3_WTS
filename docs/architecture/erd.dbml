// WTS 모의투자 — 논리 데이터 모델 (한글)
//

Project WTS_모의투자 {
  database_type: 'MySQL'
  Note: '''
  실제 한국 주식시장 시세로 가상 자금 거래를 연습하는 모의투자 WTS.
  데이터베이스가 서비스마다 하나씩 셋으로 나뉜다.
  '''
}

// ═══════════════════════════════════════════════
// wts_user — user-service
// ═══════════════════════════════════════════════

Table "사용자" {
  "사용자ID" varchar(36) [pk, note: 'users.id · UUID. 서비스 경계를 넘나들어 전역 유일해야 한다']
  "이메일" varchar(255) [not null, unique, note: 'users.email · 소문자로 정규화해 저장']
  "닉네임" varchar(50) [not null, note: 'users.nickname · 비우고 로그인하면 이메일 앞부분을 쓴다']
  "생성일시" datetime [not null, note: 'users.created_at · UTC']
  "수정일시" datetime [not null, note: 'users.updated_at · UTC']

  Note: '''
  사용자  (물리: users)

  이메일 유일키는 같은 이메일로 재로그인할 때 기존 사용자를 돌려주기 위한 것이다.
  동시 요청으로 중복 생성되는 것을 DB에서 막는다.
  '''
}

Table "관심종목" {
  "관심종목ID" bigint [pk, increment, note: 'watchlists.id']
  "사용자ID" varchar(36) [not null, note: 'watchlists.user_id']
  "종목코드" varchar(20) [not null, note: 'watchlists.symbol · 6자리 숫자']
  "담은일시" datetime [not null, note: 'watchlists.created_at · UTC']

  indexes {
    ("사용자ID", "종목코드") [unique, name: '같은 종목을 두 번 담을 수 없다']
  }
  Note: '''
  관심종목  (물리: watchlists)

  이 프로젝트에서 유일하게 DB 외래키가 걸린 관계다. 사용자와 같은 DB에 있어서 가능하다.
  사용자가 지워지면 관심종목도 함께 지워진다 (ON DELETE CASCADE).
  '''
}

// ═══════════════════════════════════════════════
// wts_trading — trading-service
// ═══════════════════════════════════════════════

Table "가상계좌" {
  "계좌ID" bigint [pk, increment, note: 'virtual_accounts.id']
  "사용자ID" varchar(36) [not null, unique, note: 'virtual_accounts.user_id · 다른 DB의 사용자를 가리킨다. FK 없음']
  "예수금" "decimal(19,4)" [not null, note: 'virtual_accounts.cash_balance · 예약금은 여기서 빠지지 않는다']
  "예약예수금" "decimal(19,4)" [not null, default: 0, note: 'virtual_accounts.reserved_cash · 미체결 매수가 묶어둔 금액']
  "버전" bigint [not null, default: 0, note: 'virtual_accounts.version · 낙관적 락']
  "개설일시" datetime [not null, note: 'virtual_accounts.created_at · UTC']
  "수정일시" datetime [not null, note: 'virtual_accounts.updated_at · UTC']

  Note: '''
  가상계좌  (물리: virtual_accounts)

  사용자당 1개다. 계좌 조회 API가 계좌번호 없이 동작하는 것도 이 전제다.

  주문가능금액 = 예수금 - 예약예수금   (저장하지 않는 파생값)
  제약: 예수금 >= 0, 예약예수금 >= 0, 예약예수금 <= 예수금
  '''
}

Table "주문" {
  "주문ID" bigint [pk, increment, note: 'orders.id']
  "계좌ID" bigint [not null, note: 'orders.account_id']
  "종목코드" varchar(20) [not null, note: 'orders.symbol']
  "매매구분" varchar(4) [not null, note: 'orders.side · BUY 매수 / SELL 매도']
  "주문유형" varchar(8) [not null, note: 'orders.order_type · MARKET 시장가 / LIMIT 지정가']
  "주문수량" bigint [not null, note: 'orders.quantity']
  "지정가" "decimal(19,4)" [null, note: 'orders.limit_price · 지정가 주문에만 있다']
  "체결수량" bigint [not null, default: 0, note: 'orders.filled_quantity']
  "주문상태" varchar(16) [not null, note: 'orders.status · ACCEPTED 미체결 / FILLED 체결 / CANCELLED 취소 / REJECTED 거절']
  "거절사유" varchar(40) [null, note: 'orders.reject_reason · 거절된 주문에만']
  "중복방지키" varchar(64) [not null, note: 'orders.idempotency_key · 클라이언트가 만든 UUID']
  "접수일시" datetime [not null, note: 'orders.created_at · UTC']
  "수정일시" datetime [not null, note: 'orders.updated_at · UTC']

  indexes {
    ("계좌ID", "중복방지키") [unique, name: '같은 키로 두 번 주문할 수 없다']
    ("계좌ID", "주문ID") [name: '계좌별 최근 주문 조회']
  }
  Note: '''
  주문  (물리: orders)

  상태 전이
    접수 -> 검증완료 -> 미체결(ACCEPTED) -> 체결완료(FILLED)
                              └-> 취소(CANCELLED)
    접수 -> 거절(REJECTED)

  접수/검증완료는 트랜잭션 안에서만 스쳐 간다.
  저장된 주문은 항상 미체결 / 체결완료 / 취소 / 거절 넷 중 하나다.

  제약: 주문수량 > 0, 0 <= 체결수량 <= 주문수량, 지정가 주문은 지정가 필수
  '''
}

Table "보유종목" {
  "보유ID" bigint [pk, increment, note: 'positions.id']
  "계좌ID" bigint [not null, note: 'positions.account_id']
  "종목코드" varchar(20) [not null, note: 'positions.symbol']
  "보유수량" bigint [not null, default: 0, note: 'positions.quantity']
  "예약수량" bigint [not null, default: 0, note: 'positions.reserved_quantity · 미체결 매도가 묶어둔 수량']
  "평균매입단가" "decimal(19,4)" [not null, default: 0, note: 'positions.average_price · 이동평균']
  "버전" bigint [not null, default: 0, note: 'positions.version · 낙관적 락']
  "생성일시" datetime [not null, note: 'positions.created_at · UTC']
  "수정일시" datetime [not null, note: 'positions.updated_at · UTC']

  indexes {
    ("계좌ID", "종목코드") [unique, name: '한 계좌에 한 종목은 한 줄']
  }
  Note: '''
  보유종목 (포지션)  (물리: positions)

  매도가능수량 = 보유수량 - 예약수량   (저장하지 않는 파생값)

  매도는 평균매입단가를 바꾸지 않는다.
  전량 매도해도 행은 남고 보유수량 0, 평균매입단가 0이 되며 조회에서 빠진다.
  제약: 보유수량 >= 0, 예약수량 >= 0, 예약수량 <= 보유수량
  '''
}

Table "체결" {
  "체결ID" bigint [pk, increment, note: 'executions.id']
  "주문ID" bigint [not null, note: 'executions.order_id']
  "계좌ID" bigint [not null, note: 'executions.account_id · 조회 편의를 위한 비정규화']
  "종목코드" varchar(20) [not null, note: 'executions.symbol']
  "매매구분" varchar(4) [not null, note: 'executions.side · BUY / SELL']
  "체결가" "decimal(19,4)" [not null, note: 'executions.price · 주문에 없는 값이다. 여기에만 남는다']
  "체결수량" bigint [not null, note: 'executions.quantity']
  "수수료" "decimal(19,4)" [not null, default: 0, note: 'executions.fee · MVP는 0']
  "실현손익" "decimal(19,4)" [null, note: 'executions.realized_profit · 매도에만. (체결가 - 체결시점 평균단가) x 수량']
  "체결일시" datetime [not null, note: 'executions.executed_at · UTC']

  indexes {
    ("계좌ID", "체결ID") [name: '계좌별 최근 체결 조회']
    "주문ID"
  }
  Note: '''
  체결  (물리: executions)

  실현손익을 저장하는 이유: 평균매입단가는 이후 매수로 바뀌므로 나중에 재계산할 수 없다.
  MVP는 부분체결이 없어 주문 하나에 체결 0~1건이다.
  제약: 체결가 > 0, 체결수량 > 0, 수수료 >= 0
  '''
}

Table "원장기록" {
  "원장ID" bigint [pk, increment, note: 'ledger_entries.id']
  "계좌ID" bigint [not null, note: 'ledger_entries.account_id']
  "주문ID" bigint [null, note: 'ledger_entries.order_id · 주문에서 비롯된 기록에만']
  "체결ID" bigint [null, note: 'ledger_entries.execution_id · 체결에서 비롯된 기록에만']
  "기록유형" varchar(20) [not null, note: 'ledger_entries.type · INITIAL_DEPOSIT 초기입금 / BUY 매수 / SELL 매도 / FEE 수수료 / ADJUSTMENT 조정']
  "증감액" "decimal(19,4)" [not null, note: 'ledger_entries.amount · 부호 있음. 입금 양수 / 출금 음수']
  "변경전잔고" "decimal(19,4)" [not null, note: 'ledger_entries.before_balance']
  "변경후잔고" "decimal(19,4)" [not null, note: 'ledger_entries.after_balance']
  "기록일시" datetime [not null, note: 'ledger_entries.created_at · UTC']

  indexes {
    ("계좌ID", "원장ID") [name: '계좌별 최근 원장 조회']
  }
  Note: '''
  원장기록  (물리: ledger_entries)

  핵심 불변식:  변경후잔고 = 변경전잔고 + 증감액   (DB CHECK로 강제)
  이게 지켜져야 원장만으로 잔고를 재구성할 수 있다.

  초기입금에는 주문ID/체결ID가 없다. MVP는 수수료율이 0이라 수수료 기록이 생기지 않는다.
  제약: 변경후잔고 >= 0, 증감액 != 0
  '''
}

Table "발행대기이벤트" {
  "이벤트ID" bigint [pk, increment, note: 'outbox_events.id']
  "애그리거트유형" varchar(30) [not null, note: 'outbox_events.aggregate_type · Order / Execution / Account / Position / Ledger']
  "애그리거트ID" varchar(64) [not null, note: 'outbox_events.aggregate_id · Kafka 메시지 키']
  "이벤트유형" varchar(60) [not null, note: 'outbox_events.event_type · Kafka 토픽 이름과 같다']
  "이벤트본문" json [not null, note: 'outbox_events.payload_json · 봉투 전체(이벤트 고유ID 포함)']
  "발행상태" varchar(12) [not null, default: 'PENDING', note: 'outbox_events.status · PENDING 대기 / PUBLISHED 완료 / FAILED 실패']
  "재시도횟수" int [not null, default: 0, note: 'outbox_events.retry_count · 5회 초과 시 실패']
  "생성일시" datetime [not null, note: 'outbox_events.created_at · UTC']
  "발행일시" datetime [null, note: 'outbox_events.published_at · UTC']

  indexes {
    ("발행상태", "이벤트ID") [name: '대기 이벤트를 순서대로 집는다']
  }
  Note: '''
  발행대기이벤트 (Transactional Outbox)  (물리: outbox_events)

  다른 엔티티와 관계선이 없다. 애그리거트를 유형 + 문자열ID로만 가리킨다.
  여러 종류의 애그리거트를 한 테이블이 받아야 해서 외래키를 걸 수 없다.

  거래 트랜잭션이 주문/계좌 변경과 같은 커밋으로 이 행을 남기고,
  별도 발행자가 Kafka로 옮긴다. DB와 Kafka에 따로 쓰는 문제를 없애는 구조다.
  '''
}

// ═══════════════════════════════════════════════
// wts_market — market-service
// ═══════════════════════════════════════════════

Table "1분봉" {
  "종목코드" varchar(20) [pk, note: 'candles_1m.symbol']
  "봉시작시각" datetime [pk, note: 'candles_1m.open_time · 해당 분의 시작 (UTC)']
  "시가" "decimal(19,4)" [not null, note: 'candles_1m.open']
  "고가" "decimal(19,4)" [not null, note: 'candles_1m.high']
  "저가" "decimal(19,4)" [not null, note: 'candles_1m.low']
  "종가" "decimal(19,4)" [not null, note: 'candles_1m.close']
  "거래량" bigint [not null, note: 'candles_1m.volume · 해당 분 동안']

  Note: '''
  1분봉  (물리: candles_1m)

  기본키가 (종목코드, 봉시작시각) 복합키다. 대리키를 두지 않았다.
  시세 이벤트를 집계해 만든다. 거래량은 누적 거래량의 차이로 계산하므로
  같은 이벤트를 두 번 받아도 부풀지 않는다.
  제약: 고가 >= 시가·종가·저가, 저가 <= 시가·종가, 거래량 >= 0
  '''
}

// ═══════════════════════════════════════════════
// 관계
// ═══════════════════════════════════════════════

// 실제 DB 외래키 (ON DELETE CASCADE)
Ref: "관심종목"."사용자ID" > "사용자"."사용자ID"

// 서비스 경계를 넘는 논리 참조 — DB가 달라 외래키를 걸 수 없다 (1:1)
Ref: "가상계좌"."사용자ID" - "사용자"."사용자ID"

// 같은 DB 안이지만 외래키를 걸지 않은 논리 참조
Ref: "주문"."계좌ID" > "가상계좌"."계좌ID"
Ref: "보유종목"."계좌ID" > "가상계좌"."계좌ID"
Ref: "체결"."계좌ID" > "가상계좌"."계좌ID"
Ref: "원장기록"."계좌ID" > "가상계좌"."계좌ID"
Ref: "체결"."주문ID" > "주문"."주문ID"
Ref: "원장기록"."주문ID" > "주문"."주문ID"
Ref: "원장기록"."체결ID" > "체결"."체결ID"

TableGroup wts_user [note: 'user-service 전용 데이터베이스'] {
  "사용자"
  "관심종목"
}

TableGroup wts_trading [note: 'trading-service 전용 데이터베이스'] {
  "가상계좌"
  "주문"
  "보유종목"
  "체결"
  "원장기록"
  "발행대기이벤트"
}

TableGroup wts_market [note: 'market-service 전용 데이터베이스'] {
  "1분봉"
}
